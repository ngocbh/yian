# yian — example environment file.
#
# Copy it and edit:   cp .env.example .env
#
# IMPORTANT: `yian` does NOT read this file itself (Bun loads `.env` from the working
# directory when you run yian from a clone with `bun src/cli/index.ts`; Node and the binaries
# don't). Make it take effect by either sourcing it into your shell, or letting direnv load it:
#
#     source .env          # once per shell, in this directory
#   — or, with direnv —
#     direnv allow         # auto-loads on `cd` into this directory
#
# See https://yian.readthedocs.io/models/ for providers, keys and logins.
# Lines keep the `export` prefix so a plain `source .env` exports them; direnv's
# `dotenv` reads this format too.

# --- Default provider + model -------------------------------------------------
# Optional. No provider or model is built in: set them here, save a login with
# `yian auth <provider>`, or name them in the flow or with --provider/--model.
# These variables override the saved default provider and model. A flow's
# `llm_config` and `--provider`/`--model` take precedence over these variables. A
# saved login's key takes precedence over the key variables below.
# Provider is one of: ollama | anthropic | openai | google | azure | vllm | ...
# export YIAN_DEFAULT_PROVIDER=openai
# export YIAN_DEFAULT_MODEL=gpt-5.5

# --- Ollama (local models, no API key) ----------------------------------------
# Point at a running Ollama endpoint. No key needed.
# export YIAN_DEFAULT_PROVIDER=ollama
# export YIAN_DEFAULT_MODEL=qwen3.5:4b
# export OLLAMA_BASE_URL=http://localhost:11434

# --- Anthropic (Claude) — uncomment to use ------------------------------------
# export YIAN_DEFAULT_PROVIDER=anthropic
# export YIAN_DEFAULT_MODEL=claude-sonnet-4-5
# export ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (GPT) — uncomment to use ------------------------------------------
# export YIAN_DEFAULT_PROVIDER=openai
# export YIAN_DEFAULT_MODEL=gpt-5.5
# export OPENAI_API_KEY=sk-...

# --- Google (Gemini) — uncomment to use ---------------------------------------
# export YIAN_DEFAULT_PROVIDER=google
# export YIAN_DEFAULT_MODEL=gemini-3.5-flash
# export GOOGLE_API_KEY=...
