{"at":"<masked>","kind":"run_started","payload":{"call_time_llm":null,"defaults":{},"effective_llm_by_static_path":{"chat/reply":{"_connection":{"credential_id":null,"endpoint":null,"method":"api_key","source":"environment","store_path":null},"model":"claude-test","provider":"anthropic"}},"flow":{"code_root":null,"dir":"<masked>","files":{"flow.yaml":{"refs":{},"text":"id: chat\nname: chat\nllm_config: {provider: anthropic, model: claude-test}\ninput:\n  messages: !Inbox(str)\ntypedefs:\n  Msg: {role: str, text: str}\ndefs:\n  turn:\n    input:\n      history: !list(Msg)\n      log: !str\n      messages: !Inbox(str)\n    nodes:\n      heard:\n        kind: tool\n        tool_id: take\n        input:\n          from: ${input.messages}\n          take: all\n      reply:\n        kind: agent\n        input:\n          history: ${input.history}\n          message: ${join(heard.output.events)}\n        output: str\n        prompt: |-\n          Conversation so far: ${history}\n          User: ${message}\n    output:\n      history: ${input.history + [Msg(role=\"user\", text=join(heard.output.events)), Msg(role=\"assistant\", text=reply.output)]}\n      log: |-\n        ${input.log}\n        User: ${join(heard.output.events)}\n        Assistant: ${reply.output}\nnodes:\n  chat:\n    kind: loop\n    call: turn\n    input:\n      history: []\n      log: \"\"\n      messages: ${input.messages}\n    times: 3\noutput: ${chat.output.log}\n"}},"root":"flow.yaml"},"flow_fingerprint":"c8b5587cc3d044aa41407e42069fda8f8d4d0cfd7cbb4031e45978ba3fe47dda","num_workers":0,"parent":null,"skills":{},"start_wiring_override":{"messages":{"inbox":"messages"}},"tool_groups":{},"tools":{},"yian_version":"<masked>"},"run_id":"r1","schema":28,"seq":0}
