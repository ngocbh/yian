{
  "format": "yian.cassette.v1",
  "source": "synthetic",
  "description": "deepseek_context_overflow: DeepSeek's 400 'maximum context length' text is a context-length error.",
  "interactions": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.deepseek.com/chat/completions",
        "headers": {
          "content-type": "application/json",
          "accept": "application/json",
          "authorization": "<redacted>"
        },
        "json": {
          "model": "deepseek-reasoner",
          "messages": [
            {
              "role": "user",
              "content": "hi"
            }
          ],
          "stream": true,
          "stream_options": {
            "include_usage": true
          }
        }
      },
      "response": {
